# ============================================================
# kurzagin — Environment Configuration
# Copy this file to .env.local:
#   cp .env.example .env.local
# ============================================================

# 1. Cloudflare D1 Database Configuration
# The app and CLI scripts auto-detect your local Wrangler session if logged in.
# For CI/CD or direct Cloudflare REST API access, configure these:
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_DATABASE_ID="your_d1_database_id"
# Optional API Token with D1 edit permissions (falls back to ~/.config/.wrangler login token)
# CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
# Optional Worker custom domain endpoint (e.g. https://worker.kurzagin.com)
# WORKER_URL="https://worker.kurzagin.com"

# 2. Security & Hashing Salt
# Optional fallback salt for IP hashing (guest like counts)
AUTH_SECRET="generate-a-secure-random-secret"

# 4. Cloudflare R2 Object Storage (Media, Opus Audio & AVIF Album Art)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="kurzagin"
# Public URL base for accessing media (custom domain or https://pub-xxx.r2.dev)
R2_PUBLIC_URL="https://cdn.kurzagin.com"
