name = "kurzagin"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]
account_id = "your_cloudflare_account_id"

# Route configuration for custom domain / worker subdomain:
# routes = [
#   { pattern = "worker.kurzagin.com/*", zone_name = "kurzagin.com" }
# ]

[[d1_databases]]
binding = "DB"
database_name = "kurzagin"
database_id = "your_d1_database_id"
